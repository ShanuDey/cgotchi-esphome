# Copy to .env (git-ignored). Use the LAN address at home or the public one away.
CGOTCHI_HA_URL=http://homeassistant.local:8123
# Home Assistant profile page, Security, Long-lived access tokens.
CGOTCHI_HA_TOKEN=
# Only for cgotchi deploy api: the HA config folder (SMB share, mount or local path).
# CGOTCHI_DEPLOY_DIR=\\homeassistant.local\config
